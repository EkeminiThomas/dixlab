# Copy to backend/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
# Optional
# DIXLAB_CORS_ORIGINS=http://localhost:5173
# DIXLAB_DB=data/dixlab.db
# DIXLAB_UPLOADS=uploads

# Optional: email "Get in touch" messages to portfolio owners.
# Without SMTP_HOST, messages are only kept in each owner's Dixlab inbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Dixlab <no-reply@example.com>

# On the live server: strict defaults, and the API won't start with unsafe
# settings. Check first with:  .venv\Scripts\python -m app.prodcheck
# DIXLAB_ENV=production

# Admin dashboard (/admin): sign up in the app, then grant admin from backend/:
#   .venv\Scripts\python -m app.admin_cli grant you@example.com
# Admins must turn on two-step login first (default: on in production).
# DIXLAB_ADMIN_REQUIRE_2FA=true
# Interactive API docs at /docs (default: off in production).
# DIXLAB_API_DOCS=false

# Sessions: longest a login lasts, and how long unused before it ends.
# DIXLAB_SESSION_DAYS=30
# DIXLAB_SESSION_IDLE_DAYS=7

# Refuse passwords found in data breaches (Have I Been Pwned; only a 5-character
# hash prefix is sent).
# DIXLAB_PWNED_PASSWORD_CHECK=true

# Virus-scan uploads with a ClamAV daemon (uploads are refused if it's down).
# DIXLAB_CLAMAV=127.0.0.1:3310
# Brute-force limits (defaults shown):
# DIXLAB_LOGIN_FAILS_PER_EMAIL=8
# DIXLAB_LOGIN_ATTEMPTS_PER_IP=40
# DIXLAB_SIGNUPS_PER_IP=5
# DIXLAB_EVENT_RETENTION_DAYS=180

# Per-account limits (defaults shown).
# DIXLAB_STORAGE_MB_PER_USER=1024
# DIXLAB_MAX_PROJECTS_PER_USER=100
# Behind a reverse proxy (most hosts, e.g. Pxxl): how many proxies are in front
# of the app, so rate limits see visitors' real IPs. Leave 0 if unsure.
# DIXLAB_TRUST_PROXY_HOPS=1

# Account emails (confirm address, reset password) use the SMTP settings above.
# Where the frontend lives, for the links in those emails:
# DIXLAB_PUBLIC_URL=http://localhost:5173
# Local testing without an email server: print account emails in the backend
# terminal instead. NEVER on a real server (anyone reading logs could use the links).
# DIXLAB_MAIL_TO_LOG=true
