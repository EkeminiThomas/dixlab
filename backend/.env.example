# Copy to backend/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
# Optional
# DIXLAB_CORS_ORIGINS=http://localhost:5173
# DIXLAB_DB=data/dixlab.db
# DIXLAB_UPLOADS=uploads

# Optional: email "Get in touch" messages to portfolio owners.
# Without SMTP_HOST, messages are only kept in each owner's Dixlab inbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Dixlab <no-reply@example.com>
